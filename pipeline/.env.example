# RecallScope Environment Variables
# Copy this file to .env and fill in your keys. NEVER commit the .env file to version control.

# Google Gemini API Key (For Stage A and Stage B LLM processing)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Reddit API Credentials (For Phase 1 Reddit Data Collection via PRAW)
# Get yours by creating an app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID="your_reddit_client_id_here"
REDDIT_CLIENT_SECRET="your_reddit_client_secret_here"
REDDIT_USER_AGENT="RecallScope:v1.0 (by /u/your_reddit_username)"
